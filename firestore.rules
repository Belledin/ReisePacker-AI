rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared Collaborative Trips
    match /trips/{tripId} {
      // Allow reading trips by ID or share code
      allow read: if true;
      
      // Allow creating and updating collaborative trips
      allow create, update: if request.resource.data.destination is string
        && request.resource.data.updatedAt is string;
        
      // Prevent unauthorized full-database deletions
      allow delete: if false;
    }
    
    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
